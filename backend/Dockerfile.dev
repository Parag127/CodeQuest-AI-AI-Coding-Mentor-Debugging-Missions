# ==========================================
# Development Dockerfile for Backend API
# ==========================================
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=development
ENV IS_DOCKER=true
ENV PORT=5000

# Install all dependencies including devDependencies (nodemon)
COPY package.json ./
RUN npm install

# Copy source code
COPY . .

EXPOSE 5000

# Run in development mode with nodemon hot reloading
CMD ["npm", "run", "dev"]
