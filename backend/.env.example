# CodeDNA Backend Environment Configuration Template
# Copy to .env for local development (do not commit actual secrets to git)

# Server Configuration
PORT=5000
NODE_ENV=development
IS_DOCKER=false

# Allowed Client Origins for CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Safe Execution Engine (Judge0) Configuration
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# Set to 'true' to use simulated mock runner for local demo/tests without live Judge0
JUDGE0_MOCK_RUNNER=true

# AI Provider Configuration (Backend server-side only. Never expose to frontend or VITE_* variables)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

