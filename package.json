{
  "name": "dy-patil-hackathon-docker-starter",
  "version": "1.0.0",
  "description": "Full-Stack Dockerized Application (Express API + Vite React + Docker Compose)",
  "private": true,
  "scripts": {
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "test": "npm test --prefix backend",
    "build": "cd frontend && npm install --include=dev && npx vite build"
  },
  "keywords": [
    "docker",
    "docker-compose",
    "express",
    "react",
    "vite",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
